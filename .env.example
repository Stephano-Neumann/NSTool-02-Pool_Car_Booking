# Copy to .env for running outside Docker (node src/server.js). Never commit .env.
APP_ENV=local                 # local | staging | production
PORT=8080
DATA_DIR=./data               # SQLite file is DATA_DIR/app.db
AUTH_MODE=local               # local = email + password, gateway = Entra ID via Azure Easy Auth
SEED_TEST_DATA=true           # test logins + sample data; refused when APP_ENV=production
SQLITE_JOURNAL_MODE=WAL       # use DELETE when DATA_DIR is on Azure Files (SMB)

# Gateway mode only
# Gateway mode roles are fixed: Entra app roles CarPool.User (booking) and CarPool.Admin (administrator).
ALLOWED_EMAIL_DOMAINS=        # e.g. neumann.com.au; only these email domains may sign in (empty = any)

# Optional: Power Automate HTTP trigger for booking alert emails (admins can also set it in the UI)
ALERT_WEBHOOK_URL=

# Data Export API for Fabric. Empty = disabled. Generate with: openssl rand -hex 32
PLATFORM_NAME=car-booking
DATA_API_KEY=
DATA_API_KEY_NEXT=             # only during key rotation
